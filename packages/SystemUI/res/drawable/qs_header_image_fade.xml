<!--
     SPDX-FileCopyrightText: The YozakuraOS Project
     SPDX-License-Identifier: Apache-2.0

     YozakuraOS cp121: the fade at the bottom edge of the QS header image.

     Infinity wraps the image in com.bosphere.fadingedgelayout.FadingEdgeLayout with
     fel_edge="bottom" and fel_size_bottom=qs_header_image_fade_size. That library is not
     in this tree (it is not in the Infinity sources either, nor in its manifest), and it
     was used for nothing but this one fade, so the container is a plain FrameLayout here
     and the fade is this gradient drawn over the image as its foreground instead.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <gradient
        android:startColor="#00000000"
        android:endColor="#FF000000"
        android:angle="270" />
</shape>
